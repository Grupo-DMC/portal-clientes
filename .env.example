# =====================================================================
# Portal Clientes DMC · plantilla de variables de entorno
# ---------------------------------------------------------------------
# Único archivo .env versionado (ver .gitignore). Es documentación:
# NO pongas credenciales, hosts ni secretos reales aquí.
#
# Local (mismo esquema que sys_tecnicos):
#     cp .env.example .env.development     # y rellena los valores
#     npm run secreto                      # genera SESSION_SECRET y HEALTHCHECK_TOKEN
#
# Orden de carga de Next.js (gana el primero): variables del sistema,
# .env.development.local / .env.production.local, .env.local,
# .env.development / .env.production, .env.
# En producción (Vercel u otro) se definen en el panel del despliegue.
#
# Todas se leen SOLO en el servidor (lib/env.ts, lib/db/config.ts).
# NINGUNA debe llevar prefijo NEXT_PUBLIC_: eso las publicaría en el
# navegador junto con la contraseña de la base de datos.
# =====================================================================

# --- Perfil activo ---------------------------------------------------

# Fuente de los datos del portal: mock | db.
#   mock = datos de ejemplo en memoria (no necesita base de datos).
#   db   = SQL Server en SOLO LECTURA (exige las variables DB_* de abajo).
# Sin definir = mock (en producción se avisa en el log al arrancar).
DATA_SOURCE=mock

# NODE_ENV lo fija Next.js (dev → development, build/start → production).
# No lo definas aquí.

# Puerto HTTP de `npm run dev` / `npm start`. Default: 3000.
PORT=3000

# Dirección pública de la app, sin barra final (enlaces absolutos, correos).
APP_URL=http://localhost:3000

# --- Sesión ----------------------------------------------------------

# OBLIGATORIA en producción. Clave con que se firma la cookie de sesión
# (HMAC-SHA256; no es un JWT). Mínimo 32 caracteres: `npm run secreto`.
# Cambiarla invalida todas las sesiones abiertas.
SESSION_SECRET=<genera-con-npm-run-secreto>

# --- Conexión a SQL Server (solo con DATA_SOURCE=db) ------------------

# Host o IP de la instancia. Para instancia con nombre, usa solo el host
# y el puerto TCP en DB_PORT: tedious no resuelve HOST\INSTANCIA sin el
# SQL Browser.
DB_SERVER=<host-o-ip>

# Puerto TCP. Default: 1433.
DB_PORT=1433

# Nombre de la base de datos. (Antes se llamaba DB_DATABASE: renómbrala.)
DB_NAME=<nombre-de-la-base>

# Autenticación SQL. Usa una cuenta de SOLO LECTURA (rol db_datareader o
# GRANT SELECT sobre las vistas del portal), nunca `sa` ni la cuenta de
# escritura de sys_tecnicos. /api/salud avisa si la cuenta puede escribir.
DB_USER=<usuario-solo-lectura>
DB_PASSWORD=<clave>

# Cifrado del canal. Default: true. En producción es obligatorio (con
# false el arranque aborta).
DB_ENCRYPT=true

# true = acepta cualquier certificado (necesario en local con el
# autofirmado de SQL Server). En producción debe ser false.
DB_TRUST_SERVER_CERT=false

# Conexiones máximas por instancia. En serverless, bajo (2-4). Default: 4.
DB_POOL_MAX=4

# Milisegundos que una conexión ociosa sigue en el pool. Default: 30000.
DB_POOL_IDLE_MS=30000

# Milisegundos antes de rendirse al conectar / por consulta. Default: 15000.
DB_CONNECT_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=15000

# --- Diagnóstico -----------------------------------------------------

# Habilita GET /api/salud (conexión a la base, solo lectura y mapeo
# pendiente). Sin esta variable la ruta responde 404. `npm run secreto`.
#   curl -H "Authorization: Bearer <token>" http://localhost:3000/api/salud
HEALTHCHECK_TOKEN=<genera-con-npm-run-secreto>

# --- CORS ------------------------------------------------------------

# Orígenes que pueden llamar a /api/* desde el navegador, separados por
# coma y sin barra final. Vacío = solo el mismo origen (como sys_tecnicos).
#   CORS_ORIGENES=https://tecnicos.tudominio.cl
CORS_ORIGENES=
